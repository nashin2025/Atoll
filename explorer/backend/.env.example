# Explorer Backend Configuration
# Copy this file to .env and fill in your values.

# URL of the atoll-node RPC endpoint
RPC_URL=http://localhost:8081
# WebSocket URL for real-time updates
WS_URL=ws://localhost:8082
# Port the explorer backend listens on
PORT=8080
# Node environment: development, production, or test
NODE_ENV=development
# API key required for /api/v1/* endpoints (optional in development)
EXPLORER_API_KEY=
# Allowed CORS origin (e.g., http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
