{
  "$schema": "https://tauri.app/json/v2",
  "identifier": "default",
  "description": "Default capability for the Atoll GUI Wallet",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "wallet-new",
    "wallet-unlock",
    "wallet-import",
    "wallet-balance",
    "wallet-send",
    "wallet-history",
    "wallet-derive-address"
  ]
}
