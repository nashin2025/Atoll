# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Rust files
[*.rs]
indent_size = 4
max_line_length = 100

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_size = 2
max_line_length = 100

# YAML files
[*.yml]
indent_size = 2
max_line_length = 100

# JSON files
[*.json]
indent_size = 2
max_line_length = 100

# TOML files
[*.toml]
indent_size = 2
max_line_length = 100

# Shell scripts
[*.sh]
indent_size = 2
max_line_length = 100

# Dockerfiles
[Dockerfile]
indent_size = 2
max_line_length = 100

# GitHub Actions workflows
[.github/workflows/*.yml]
indent_size = 2
max_line_length = 100

# Makefiles
[Makefile]
indent_style = tab
indent_size = 4

# Python files
[*.py]
indent_size = 4
max_line_length = 100

# JavaScript/TypeScript files
[*.{js,jsx,ts,tsx}]
indent_size = 2
max_line_length = 100

# CSS/SCSS files
[*.{css,scss}]
indent_size = 2
max_line_length = 100

# HTML files
[*.html]
indent_size = 2
max_line_length = 100
