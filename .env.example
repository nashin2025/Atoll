# Environment Variables Reference
# Copy this file to .env and fill in your values
# NEVER commit real secrets to version control

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================

ATOLL_NETWORK=mainnet          # mainnet | testnet | devnet
ATOLL_CHAIN_ID=777777
ATOLL_P2P_PORT=30333
ATOLL_RPC_PORT=8545
ATOLL_WS_PORT=8546
ATOLL_API_PORT=8080
ATOLL_GRAPHQL_PORT=4000

# ============================================================================
# NODE CONFIGURATION
# ============================================================================

ATOLL_DATA_DIR=./data
ATOLL_MAX_PEERS=256
ATOLL_BOOT_NODES=
ATOLL_NODE_NAME=
ATOLL_NODE_DESCRIPTION=

# ============================================================================
# VALIDATOR CONFIGURATION
# ============================================================================

ATOLL_VALIDATOR_KEY=
ATOLL_VALIDATOR_ADDRESS=
ATOLL_STAKE_AMOUNT=10000       # Minimum 10,000 ATOLL
ATOLL_VALIDATOR_ENABLED=false

# ============================================================================
# MINING CONFIGURATION (PoUW)
# ============================================================================

ATOLL_MINING_ENABLED=false
ATOLL_MINING_THREADS=4
ATOLL_MEMORY_LIMIT_GB=4        # Morph-Hash requires 4GB
ATOLL_MINING_DIFFICULTY_TARGET=
ATOLL_MINING_POOL_URL=

# ============================================================================
# STORAGE FARMER CONFIGURATION (PoST)
# ============================================================================

ATOLL_FARMING_ENABLED=false
ATOLL_PLOT_SIZE_GB=100         # Minimum 100 GB
ATOLL_PLOT_DIR=./plots
ATOLL_FARMING_REWARD_ADDRESS=

# ============================================================================
# API CONFIGURATION
# ============================================================================

ATOLL_API_ENABLED=true
ATOLL_GRAPHQL_ENABLED=true
ATOLL_GRAPHQL_PORT=4000
ATOLL_API_RATE_LIMIT=100
ATOLL_API_CORS_ORIGINS=

# ============================================================================
# LOGGING AND TELEMETRY
# ============================================================================

ATOLL_LOG_LEVEL=info           # error | warn | info | debug | trace
ATOLL_LOG_FORMAT=json
ATOLL_LOG_FILE=./logs/atoll.log
ATOLL_LOG_ROTATION_SIZE=100    # MB
ATOLL_LOG_ROTATION_COUNT=5

ATOLL_TELEMETRY_ENABLED=false
ATOLL_TELEMETRY_ENDPOINT=
ATOLL_TELEMETRY_INTERVAL=60    # seconds

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

ATOLL_SECRET_KEY=              # Change this in production! (32+ bytes random)
ATOLL_ENCRYPTION_KEY=          # For data at rest encryption
ATOLL_SESSION_SECRET=          # For session management
ATOLL_API_KEY=                 # API authentication key
ATOLL_WEBHOOK_SECRET=          # For webhook signature verification
ATOLL_TLS_CERT_PATH=           # Path to TLS certificate
ATOLL_TLS_KEY_PATH=            # Path to TLS private key
ATOLL_TLS_CA_PATH=             # Path to CA certificate
ATOLL_RATE_LIMIT_ENABLED=true
ATOLL_RATE_LIMIT_REQUESTS=100
ATOLL_RATE_LIMIT_WINDOW=60     # seconds

# ============================================================================
# FEATURE FLAGS
# ============================================================================

ATOLL_FEATURE_SHARDING=false
ATOLL_FEATURE_PRIVACY=false
ATOLL_FEATURE_AI_VM=false
ATOLL_FEATURE_GOVERNANCE=false
ATOLL_FEATURE_CROSS_SHARD=false
ATOLL_FEATURE_ZK_PROOFS=false

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

ATOLL_DB_URL=                  # Database connection string
ATOLL_DB_POOL_SIZE=10
ATOLL_DB_MAX_OVERFLOW=20
ATOLL_DB_ECHO=false            # Enable SQL query logging

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

ATOLL_REDIS_URL=               # Redis connection string for caching
ATOLL_REDIS_DB=0
ATOLL_REDIS_POOL_SIZE=10

# ============================================================================
# MONITORING AND OBSERVABILITY
# ============================================================================

ATOLL_PROMETHEUS_ENABLED=false
ATOLL_PROMETHEUS_PORT=9090
ATOLL_GRAFANA_ENABLED=false
ATOLL_GRAFANA_PORT=3000
ATOLL_TRACING_ENABLED=false
ATOLL_TRACING_ENDPOINT=
ATOLL_HEALTH_CHECK_ENABLED=true
ATOLL_HEALTH_CHECK_PORT=8081
ATOLL_HEALTH_CHECK_INTERVAL=30 # seconds

# ============================================================================
# CI/CD CONFIGURATION
# ============================================================================

ATOLL_CI_ENABLED=false
ATOLL_CI_REGISTRY=ghcr.io
ATOLL_CI_IMAGE_NAME=atoll-node
ATOLL_DOCKER_REGISTRY=
ATOLL_DOCKER_USERNAME=
ATOLL_DOCKER_PASSWORD=

# ============================================================================
# SECURITY SCANNING
# ============================================================================

ATOLL_SAST_ENABLED=false
ATOLL_SCA_ENABLED=false
ATOLL_SECRET_SCAN_ENABLED=false
ATOLL_DEPENDENCY_SCAN_ENABLED=false

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

ATOLL_BACKUP_ENABLED=false
ATOLL_BACKUP_SCHEDULE="0 2 * * *"   # Daily at 2 AM
ATOLL_BACKUP_RETENTION_DAYS=7
ATOLL_BACKUP_ENCRYPTION_KEY=

# ============================================================================
# DEPRECATED - DO NOT USE IN NEW CODE
# ============================================================================

# ATOLL_OLD_SETTING=              # Removed in v0.1.0 - use ATOLL_NEW_SETTING instead
